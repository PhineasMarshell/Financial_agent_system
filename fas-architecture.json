  "cards": [
    {
      "dot": "cyan",
      "title": "主路径 (新闻 → 成交)",
      "items": [
        "News Feed WS 推送 → WS Gateway 一层过滤 → asyncio 缓冲队列",
        "LangGraph: Router Agent 判定标的 → dispatch 到 BTC/Gold Analyst",
        "Analyst 经 Tool Layer (src/tools/) 调 hyperliquid_query (Info 只读行情) / search_news",
        "信号 JSON 写入 SQLite → Trade Executor 30s 轮询 → 风控 → 下单回写"
      ]
    },
    {
      "dot": "amber",
      "title": "外部依赖",
      "items": [
        "News Feed WS 服务 (FEED_API_BASE_URL + token)",
        "LLM API: qwen3.7-plus, OpenAI 兼容接口 (LLM_BASE_URL)",
        "Hyperliquid API: Info 行情 / Exchange 交易 (testnet|mainnet)",
        "DuckDuckGo News (ddgs) 新闻检索"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界",
      "items": [
        "外部服务全部位于本地进程边界之外",
        "私钥仅存在于 Trade Executor (HYPERLIQUID_PRIVATE_KEY)",
        "Dashboard API 独立进程, CORS allow_origins=* 且无鉴权",
        "行情只读查询与签名下单权限在边界上分离"
      ]
    },
    {
      "dot": "violet",
      "title": "现状备注",
      "items": [
        "gold dispatch 在 main.py 中暂被注释关闭 (虚线)",
        "风控: 置信度 ≥5, 价格偏离 ≤2%, 仓位上限 30%, 杠杆 1x",
        "默认 testnet, is_paper_trade 标记纸面交易"
      ]
    }
  ]
